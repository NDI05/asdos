ASDOS_ENV=development
ASDOS_DATABASE_URL=sqlite:///./data/asdos-dev.sqlite3
ASDOS_REDIS_URL=redis://127.0.0.1:6379/0
ASDOS_ARTIFACT_DIR=./data/private
ASDOS_MODEL_DIR=./models/Qwen3-VL-4B-Instruct
ASDOS_MODEL_REVISION=ebb281ec70b05090aa6165b016eac8ec08e71b17
# Qwen stays the default. Set ASDOS_TRANSCRIBER=trocr to use the local experimental handwriting checkpoint.
ASDOS_TRANSCRIBER=qwen
ASDOS_TROCR_DIR=./data/private/trocr-all-2348-v1/model-final
ASDOS_SESSION_SECRET=
ASDOS_COOKIE_SECURE=false
ASDOS_CELERY_EAGER=true
ASDOS_AUTO_CREATE=true
ASDOS_MODEL_ALLOW_CPU=false
ASDOS_MAX_UPLOAD_BYTES=52428800
ASDOS_MAX_PDF_PAGES=100
ASDOS_MAX_RENDER_PIXELS=25000000
ASDOS_MAX_REQUEST_BYTES=54525952
ASDOS_RENDER_DPI=250
ASDOS_EXPORT_RETENTION_DAYS=0
ASDOS_DB_PASSWORD=CHANGE-THIS-BEFORE-COMPOSE
ASDOS_API_URL=http://api:8000
